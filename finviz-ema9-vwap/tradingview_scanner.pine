//@version=5
indicator("EMA9 VWAP Scanner", overlay = true)
tf = input.timeframe("3", "Timeframe")
s1 = input.symbol("NASDAQ:AAPL", "Symbol 1")
s2 = input.symbol("NASDAQ:TSLA", "Symbol 2")
s3 = input.symbol("NASDAQ:NVDA", "Symbol 3")
s4 = input.symbol("NASDAQ:AMD", "Symbol 4")
s5 = input.symbol("NASDAQ:PLTR", "Symbol 5")
s6 = input.symbol("NYSE:SOFI", "Symbol 6")
s7 = input.symbol("NASDAQ:RIVN", "Symbol 7")
s8 = input.symbol("NYSE:F", "Symbol 8")
s9 = input.symbol("NASDAQ:LCID", "Symbol 9")
s10 = input.symbol("NASDAQ:MARA", "Symbol 10")
f() => [close, ta.ema(close, 9), ta.vwap(hlc3), ta.barssince(ta.crossover(ta.ema(close, 9), ta.vwap(hlc3)))]
[c1, e1, v1, b1] = request.security(s1, tf, f())
[c2, e2, v2, b2] = request.security(s2, tf, f())
[c3, e3, v3, b3] = request.security(s3, tf, f())
[c4, e4, v4, b4] = request.security(s4, tf, f())
[c5, e5, v5, b5] = request.security(s5, tf, f())
[c6, e6, v6, b6] = request.security(s6, tf, f())
[c7, e7, v7, b7] = request.security(s7, tf, f())
[c8, e8, v8, b8] = request.security(s8, tf, f())
[c9, e9, v9, b9] = request.security(s9, tf, f())
[c10, e10, v10, b10] = request.security(s10, tf, f())
st(e, v, b) => e > v and nz(b, 999) <= 3 ? "BUY NOW" : e > v ? "Above VWAP" : "Below VWAP"
col(e, v, b) => e > v and nz(b, 999) <= 3 ? color.green : e > v ? color.teal : color.gray
var t = table.new(position.top_right, 3, 11, bgcolor = color.new(color.black, 20), border_width = 1)
table.cell(t, 0, 0, "Symbol", text_color = color.white)
table.cell(t, 1, 0, "Price", text_color = color.white)
table.cell(t, 2, 0, "Status", text_color = color.white)
table.cell(t, 0, 1, s1, text_color = color.white)
table.cell(t, 1, 1, str.tostring(c1, "#.##"), text_color = color.white)
table.cell(t, 2, 1, st(e1, v1, b1), text_color = color.white, bgcolor = col(e1, v1, b1))
table.cell(t, 0, 2, s2, text_color = color.white)
table.cell(t, 1, 2, str.tostring(c2, "#.##"), text_color = color.white)
table.cell(t, 2, 2, st(e2, v2, b2), text_color = color.white, bgcolor = col(e2, v2, b2))
table.cell(t, 0, 3, s3, text_color = color.white)
table.cell(t, 1, 3, str.tostring(c3, "#.##"), text_color = color.white)
table.cell(t, 2, 3, st(e3, v3, b3), text_color = color.white, bgcolor = col(e3, v3, b3))
table.cell(t, 0, 4, s4, text_color = color.white)
table.cell(t, 1, 4, str.tostring(c4, "#.##"), text_color = color.white)
table.cell(t, 2, 4, st(e4, v4, b4), text_color = color.white, bgcolor = col(e4, v4, b4))
table.cell(t, 0, 5, s5, text_color = color.white)
table.cell(t, 1, 5, str.tostring(c5, "#.##"), text_color = color.white)
table.cell(t, 2, 5, st(e5, v5, b5), text_color = color.white, bgcolor = col(e5, v5, b5))
table.cell(t, 0, 6, s6, text_color = color.white)
table.cell(t, 1, 6, str.tostring(c6, "#.##"), text_color = color.white)
table.cell(t, 2, 6, st(e6, v6, b6), text_color = color.white, bgcolor = col(e6, v6, b6))
table.cell(t, 0, 7, s7, text_color = color.white)
table.cell(t, 1, 7, str.tostring(c7, "#.##"), text_color = color.white)
table.cell(t, 2, 7, st(e7, v7, b7), text_color = color.white, bgcolor = col(e7, v7, b7))
table.cell(t, 0, 8, s8, text_color = color.white)
table.cell(t, 1, 8, str.tostring(c8, "#.##"), text_color = color.white)
table.cell(t, 2, 8, st(e8, v8, b8), text_color = color.white, bgcolor = col(e8, v8, b8))
table.cell(t, 0, 9, s9, text_color = color.white)
table.cell(t, 1, 9, str.tostring(c9, "#.##"), text_color = color.white)
table.cell(t, 2, 9, st(e9, v9, b9), text_color = color.white, bgcolor = col(e9, v9, b9))
table.cell(t, 0, 10, s10, text_color = color.white)
table.cell(t, 1, 10, str.tostring(c10, "#.##"), text_color = color.white)
table.cell(t, 2, 10, st(e10, v10, b10), text_color = color.white, bgcolor = col(e10, v10, b10))
alertcondition(nz(b1, 999) == 0 or nz(b2, 999) == 0 or nz(b3, 999) == 0 or nz(b4, 999) == 0 or nz(b5, 999) == 0 or nz(b6, 999) == 0 or nz(b7, 999) == 0 or nz(b8, 999) == 0 or nz(b9, 999) == 0 or nz(b10, 999) == 0, "Any symbol: EMA9 crossed above VWAP", "EMA9 crossed ABOVE VWAP on one of the scanner symbols")
